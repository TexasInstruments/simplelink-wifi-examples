<?xml version="1.0" encoding="UTF-8"?>
<projectSpec>
    <applicability>
        <when>
            <context
                deviceFamily="ARM"
                deviceId="Cortex M.CC35X1E"
            />
        </when>
    </applicability>

    <project
        title="Vendor BL3"
        name="bl3_LP_EM_CC35X1_nortos_gcc"
        configurations="Debug"
        toolChain="GNU"
        connection="TIXDS110_Connection.xml"
        device="Cortex M.CC35X1E"
        ignoreDefaultDeviceSettings="true"
        ignoreDefaultCCSSettings="false"
        products="com.ti.SIMPLELINK_WIFI_SDK;com.ti.SIMPLELINK_WIFI_TOOLBOX;sysconfig"
        compilerBuildOptions="
            -I${PROJECT_ROOT}
            -I${PROJECT_ROOT}/${ConfigName}
            -I${PROJECT_LOC}/mcuboot
            -I${PROJECT_LOC}/mcuboot/src
            -I${PROJECT_LOC}/mcuboot/ti/include
            -I${PROJECT_LOC}/mbedtls/include
            -DMBEDTLS_CONFIG_FILE=\&quot;mbedtls_config_bl3.h\&quot;
            -O3
            -DCC35XX
            -DDeviceFamily_CC35XX
            -DNVOCMP_POSIX_MUTEX
            -I${COM_TI_SIMPLELINK_WIFI_SDK_INSTALL_DIR}/source
            -I${COM_TI_SIMPLELINK_WIFI_SDK_INSTALL_DIR}/kernel/nortos
            -I${COM_TI_SIMPLELINK_WIFI_SDK_INSTALL_DIR}/kernel/nortos/posix
            -mcpu=cortex-m33
            -mthumb
            -std=c99
            -std=c++11
            -mfloat-abi=hard
            -mfpu=fpv5-sp-d16
            -ffunction-sections
            -fdata-sections
            -g
            -Wall
            -I${CG_TOOL_ROOT}/arm-none-eabi/include/newlib-nano
            -I${CG_TOOL_ROOT}/arm-none-eabi/include
        "
        linkerBuildOptions="
            -mcpu=cortex-m33
            -L${COM_TI_SIMPLELINK_WIFI_SDK_INSTALL_DIR}/source
            -Wl,--wrap=memcpy
            -Wl,--wrap=memset
            -fno-lto
            -eresetISR
            -L${COM_TI_SIMPLELINK_WIFI_SDK_INSTALL_DIR}/kernel/nortos
            -Wl,-l${COM_TI_SIMPLELINK_WIFI_SDK_INSTALL_DIR}/source/ti/net/wifi_stack/lib/gcc/wifi_stack.a
            -Wl,-l${COM_TI_SIMPLELINK_WIFI_SDK_INSTALL_DIR}/source/third_party/hostap/lib/gcc/hostap.a
            -Wl,-l${COM_TI_SIMPLELINK_WIFI_SDK_INSTALL_DIR}/source/third_party/lwip/lib/gcc/lwip.a
            -Wl,-l${COM_TI_SIMPLELINK_WIFI_SDK_INSTALL_DIR}/source/third_party/nimble/lib/gcc/nimble.a
            -Wl,-l${COM_TI_SIMPLELINK_WIFI_SDK_INSTALL_DIR}/source/ti/net/ble_interface/lib/gcc/ble_interface.a
            -Wl,-l${COM_TI_SIMPLELINK_WIFI_SDK_INSTALL_DIR}/source/ti/drivers/net/wifi/wifi_host_driver/lib/gcc/wifi_host_driver.a
            -Wl,-l${COM_TI_SIMPLELINK_WIFI_SDK_INSTALL_DIR}/source/ti/drivers/net/wifi/wifi_platform/cc35xx/lib/gcc/wifi_platform_cc35xx.a
            -Wl,-l${COM_TI_SIMPLELINK_WIFI_SDK_INSTALL_DIR}/source/ti/utils/FWU/lib/gcc/FWU.a
            -L${PROJECT_BUILD_DIR}/syscfg
            -lti_utils_build_linker.cmd.genlibs
            -mthumb
            -mfloat-abi=hard
            -mfpu=fpv5-sp-d16
            -nostartfiles
            -static
            -Wl,--gc-sections
            -lgcc
            -lc
            -lm
            --specs=nano.specs
            --specs=nosys.specs
        "
        enableHexTool="true"
        hexBuildOptions="-O binary"
        sysConfigBuildOptions="
            --product ${COM_TI_SIMPLELINK_WIFI_SDK_INSTALL_DIR}/.metadata/product.json
            --product ${COM_TI_SIMPLELINK_WIFI_TOOLBOX_INSTALL_DIR}/.metadata/product.json
            --compiler gcc
        "
        description="Boot lodaer for customer use">
        <property name="launch.loadSymbolsOnly" value="true"/>
        <property name="buildProfile" value="release"/>
        <property name="isHybrid" value="true"/>
